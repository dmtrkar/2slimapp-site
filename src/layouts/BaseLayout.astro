---
interface Props {
  title: string;
  description?: string;
}
const { title, description = '2Slim — 5 Habits of Slim People. No diet, natural weight loss.' } = Astro.props;
const APP_STORE_URL = 'https://apps.apple.com/app/id1524615454';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — 2Slim Blog</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">2Slim <span>Blog</span></a>
      <nav>
        <a href="/">Articles</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <section class="app-cta">
      <div class="app-cta-text">
        <p class="app-cta-title">Try 2Slim</p>
        <p class="app-cta-desc">5 simple daily habits. No calorie counting, no diets.</p>
        <a class="app-store-badge" href={APP_STORE_URL} target="_blank" rel="noopener">
          <span>
            <small>Download on the</small>
            <strong>App Store</strong>
          </span>
        </a>
      </div>
      <img class="app-cta-qr" src="/app-qr.png" width="120" height="120" alt="QR code to download 2Slim on the App Store" loading="lazy" />
    </section>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} 2Slim.
        <a href="https://dmtrkar.github.io/2slim/">Support &amp; Privacy Policy</a>
      </p>
    </footer>
    <style is:global>
      :root {
        --teal: #4a9e9e;
        --ink: #1f2a2a;
        --paper: #fbfaf7;
        --muted: #6b7a7a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: var(--ink);
        background: var(--paper);
        line-height: 1.6;
      }
      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #e7e2d8;
      }
      .brand { font-weight: 700; font-size: 1.25rem; color: var(--ink); text-decoration: none; }
      .brand span { color: var(--teal); }
      nav a { color: var(--muted); text-decoration: none; margin-left: 1rem; }
      main { max-width: 760px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
      .site-footer {
        text-align: center;
        padding: 2rem 1.5rem;
        color: var(--muted);
        font-size: 0.875rem;
        border-top: 1px solid #e7e2d8;
      }
      .site-footer a { color: var(--teal); }
      a { color: var(--teal); }
      h1, h2, h3 { line-height: 1.25; }
      img { max-width: 100%; border-radius: 12px; }
      .app-cta {
        max-width: 760px;
        margin: 1rem auto 0;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        background: #f0ebe0;
        border-radius: 16px;
      }
      .app-cta-title { margin: 0 0 0.25rem; font-weight: 700; color: var(--ink); }
      .app-cta-desc { margin: 0 0 0.9rem; color: var(--muted); font-size: 0.9rem; }
      .app-store-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--ink);
        color: #fff;
        text-decoration: none;
        padding: 0.55rem 1rem;
        border-radius: 10px;
      }
      .app-store-badge:hover { opacity: 0.9; }
      .app-store-badge small { display: block; font-size: 0.65rem; line-height: 1; opacity: 0.85; }
      .app-store-badge strong { display: block; font-size: 1rem; line-height: 1.2; }
      .app-cta-qr { border-radius: 8px; flex-shrink: 0; }
      @media (max-width: 560px) {
        .app-cta { flex-direction: column; text-align: center; }
      }
    </style>
  </body>
</html>
