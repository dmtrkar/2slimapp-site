---
interface Props {
  title: string;
  description?: string;
}
const { title, description = '2Slim — 5 привычек стройности без диет' } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — 2Slim Blog</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">2Slim <span>Blog</span></a>
      <nav>
        <a href="/">Статьи</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} 2Slim.
        <a href="https://dmtrkar.github.io/2slim/">Поддержка и политика конфиденциальности</a>
      </p>
    </footer>
    <style is:global>
      :root {
        --teal: #4a9e9e;
        --ink: #1f2a2a;
        --paper: #fbfaf7;
        --muted: #6b7a7a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: var(--ink);
        background: var(--paper);
        line-height: 1.6;
      }
      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #e7e2d8;
      }
      .brand { font-weight: 700; font-size: 1.25rem; color: var(--ink); text-decoration: none; }
      .brand span { color: var(--teal); }
      nav a { color: var(--muted); text-decoration: none; margin-left: 1rem; }
      main { max-width: 760px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
      .site-footer {
        text-align: center;
        padding: 2rem 1.5rem;
        color: var(--muted);
        font-size: 0.875rem;
        border-top: 1px solid #e7e2d8;
      }
      .site-footer a { color: var(--teal); }
      a { color: var(--teal); }
      h1, h2, h3 { line-height: 1.25; }
      img { max-width: 100%; border-radius: 12px; }
    </style>
  </body>
</html>
