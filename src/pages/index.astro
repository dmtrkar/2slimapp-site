---
import BaseLayout from '../layouts/BaseLayout.astro';
import HabitsGrid from '../components/HabitsGrid.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<BaseLayout title="Home" wide>
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">5 Habits of Slim People</p>
      <h1 class="hero-headline">Articles on habits, diet-free weight loss, and what actually works.</h1>
      {articles.length > 0 && (
        <a class="hero-link" href="#articles">
          Read the latest
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      )}
    </div>
    <div class="hero-panel">
      <img src="/images/habits/hero-five-habits.jpg" alt="Five smooth stones arranged in a row, one tinted terracotta clay" />
      <div class="overlay">
        <div class="numeral">05</div>
        <div class="label">Habits</div>
        <div class="tagline">No diet, natural weight loss.</div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="habits">
    <p class="habits-eyebrow">Explore by habit</p>
    <HabitsGrid />
  </section>

  <hr class="rule" />

  <section class="index" id="articles">
    <p class="index-eyebrow">Articles</p>
    {articles.map((article, i) => (
      <a class="article-row" href={`/${article.data.slug}/`}>
        <div class="numeral">{String(i + 1).padStart(2, '0')}</div>
        <div>
          <h2>{article.data.title}</h2>
          {article.data.description && <p>{article.data.description}</p>}
        </div>
      </a>
    ))}
  </section>

  <style>
    .hero {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 40px;
      align-items: stretch;
      padding: 8px 0 48px;
    }
    .hero-copy { display: flex; flex-direction: column; gap: 22px; justify-content: center; }
    .kicker {
      font-family: var(--font-sans);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--clay);
      font-weight: 600;
    }
    .hero-headline {
      font-family: var(--font-serif);
      font-size: 2.3rem;
      line-height: 1.18;
      margin: 0;
      color: var(--ink);
      font-weight: 500;
    }
    .hero-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-sans);
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--ink);
      text-decoration: none;
      width: fit-content;
      padding-bottom: 3px;
      border-bottom: 1px solid var(--ink);
    }
    .hero-link svg { width: 14px; height: 14px; }
    .hero-panel {
      position: relative;
      min-height: 240px;
      overflow: hidden;
      color: var(--sand);
    }
    .hero-panel img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .hero-panel .overlay {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      padding: 20px 22px;
      background: linear-gradient(180deg, rgba(31,42,42,0) 0%, rgba(31,42,42,0.55) 100%);
    }
    .hero-panel .numeral { font-family: var(--font-serif); font-size: 3.4rem; line-height: 0.85; font-weight: 500; color: var(--sand); }
    .hero-panel .label { font-family: var(--font-sans); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.9; margin: 6px 0 4px; color: var(--sand); }
    .hero-panel .tagline { font-family: var(--font-serif); font-size: 0.98rem; line-height: 1.4; color: var(--sand); }

    hr.rule { border: none; border-top: 1px solid var(--hair); margin: 0; }

    .habits { padding: 40px 0; }
    .habits-eyebrow {
      font-family: var(--font-sans);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 0 24px;
    }

    .index { padding: 48px 0 16px; }
    .index-eyebrow {
      font-family: var(--font-sans);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 0 24px;
    }
    .article-row {
      display: grid;
      grid-template-columns: 56px 1fr;
      gap: 20px;
      padding: 28px 0;
      border-bottom: 1px solid var(--hair);
      text-decoration: none;
      color: inherit;
    }
    .article-row:first-of-type { padding-top: 0; }
    .article-row .numeral { font-family: var(--font-serif); font-size: 2rem; color: var(--clay); line-height: 1; }
    .article-row h2 { font-family: var(--font-serif); font-size: 1.35rem; font-weight: 500; margin: 0 0 8px; color: var(--ink); }
    .article-row p { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.55; max-width: 56ch; }

    @media (max-width: 720px) {
      .hero { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
